# ==============================================================================
# AI Procurement & Vendor Intelligence Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Sourcyn - AI Procurement & Vendor Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (JSON array or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=procure_user
POSTGRES_PASSWORD=procure_password
POSTGRES_DB=procure_db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis Configuration (Cache & Message Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=procurement-documents
S3_REGION=us-east-1

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o

# OpenAI (Optional if using Gemini/Anthropic)
OPENAI_API_KEY=

# Anthropic (Optional)
ANTHROPIC_API_KEY=

# Google Gemini (Optional)
GEMINI_API_KEY=

# LangGraph & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-procurement-platform
